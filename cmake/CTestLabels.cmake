# CI-OPT1 labels all tests after CMake has processed the whole root directory.
# In particular, a parallel HW4 PR can append add_test() without moving this include.
function(ci_opt1_apply_test_labels)
    # CI-OPT1: name-derived CTest labels for every test defined in this directory.
    # Kept separate from product CMake declarations. A later test (e.g. HW4-C3-B2)
    # is included automatically when this file is included after all add_test calls.
    get_property(_ci_opt1_tests DIRECTORY PROPERTY TESTS)
    foreach(_ci_opt1_test IN LISTS _ci_opt1_tests)
        set(_ci_opt1_labels "")
        if(_ci_opt1_test MATCHES "integer|numeric|j1_|signed")
            list(APPEND _ci_opt1_labels INTEGER)
        endif()
        if(_ci_opt1_test MATCHES "executor|session|termination|comments|host_cli|if_then|gosub|return")
            list(APPEND _ci_opt1_labels BASIC_CONTROL_FLOW)
        endif()
        if(_ci_opt1_test MATCHES "cpc_video|cpc_text|hw4_c1|hw4_c3")
            list(APPEND _ci_opt1_labels VIDEO)
        endif()
        if(_ci_opt1_test MATCHES "hw4_c2|uart")
            list(APPEND _ci_opt1_labels UART)
        endif()
        if(_ci_opt1_test MATCHES "memory_budget")
            list(APPEND _ci_opt1_labels MEMORY)
        endif()
        if(_ci_opt1_test MATCHES "cpc_|permanent|differential|provenance|evidence|j0_.*audit")
            list(APPEND _ci_opt1_labels CPC_PERMANENT)
        endif()
        if(_ci_opt1_labels)
            list(REMOVE_DUPLICATES _ci_opt1_labels)
            set_tests_properties("${_ci_opt1_test}" PROPERTIES LABELS "${_ci_opt1_labels}")
        endif()
    endforeach()
    unset(_ci_opt1_tests)
    unset(_ci_opt1_test)
    unset(_ci_opt1_labels)
endfunction()

# DEFER introduced in CMake 3.19. Older 3.13-3.18 builds still configure and
# execute all tests, but require a modern CMake to expose the optional labels.
if(CMAKE_VERSION VERSION_GREATER_EQUAL "3.19")
    cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL ci_opt1_apply_test_labels)
else()
    message(STATUS "CI-OPT1: CTest labels need CMake 3.19+, all tests remain active")
endif()
