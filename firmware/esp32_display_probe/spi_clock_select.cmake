# HW4-DISP-SPI40-A: strict, testable build-time selection.
# Included after profile_select.cmake; also testable via cmake -P.
if(NOT DEFINED LOCO_CYD_PROFILE)
  message(FATAL_ERROR "HW4-SPI40 missing LOCO_CYD_PROFILE")
endif()
if(NOT DEFINED CYD_LCD_SPI_HZ)
  set(CYD_LCD_SPI_HZ "20000000")
endif()
if(NOT (CYD_LCD_SPI_HZ STREQUAL "20000000" OR CYD_LCD_SPI_HZ STREQUAL "40000000"))
  message(FATAL_ERROR "HW4-SPI40 INVALID_REQUEST '${CYD_LCD_SPI_HZ}': only 20000000 or 40000000")
endif()
if(NOT LOCO_CYD_PROFILE STREQUAL "CONSOLE" AND CYD_LCD_SPI_HZ STREQUAL "40000000")
  message(FATAL_ERROR "HW4-SPI40 CONSOLE_ONLY: ${LOCO_CYD_PROFILE} must use 20000000")
endif()
set(CYD_LCD_SPI_HZ "${CYD_LCD_SPI_HZ}" CACHE STRING
    "LCD SPI request in Hz, default 20000000, CONSOLE-only 40000000")
set_property(CACHE CYD_LCD_SPI_HZ PROPERTY STRINGS 20000000 40000000)
message(STATUS "HW4-SPI40 BUILD_PROFILE=${LOCO_CYD_PROFILE} REQUESTED_SPI_HZ=${CYD_LCD_SPI_HZ} EFFECTIVE_SPI_HZ=UNMEASURED")
