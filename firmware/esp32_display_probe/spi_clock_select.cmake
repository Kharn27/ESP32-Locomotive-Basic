# HW4-DISP-PROFILE-A-C3: strict build-time target, no runtime retuning.
# Included after profile_select.cmake. Standalone validation: cmake -P.
if(NOT DEFINED LOCO_CYD_PROFILE)
  message(FATAL_ERROR "HW4-DISP-C3 missing LOCO_CYD_PROFILE")
endif()
if(NOT DEFINED CYD_LCD_SPI_HZ)
  if(LOCO_CYD_PROFILE STREQUAL "CONSOLE")
    set(CYD_LCD_SPI_HZ "40000000")
  else()
    set(CYD_LCD_SPI_HZ "20000000")
  endif()
endif()
if(NOT (CYD_LCD_SPI_HZ STREQUAL "20000000" OR
        CYD_LCD_SPI_HZ STREQUAL "40000000"))
  message(FATAL_ERROR "HW4-DISP-C3 INVALID_SPI_HZ '${CYD_LCD_SPI_HZ}': only 20000000 or 40000000")
endif()
if(NOT LOCO_CYD_PROFILE STREQUAL "CONSOLE" AND
   CYD_LCD_SPI_HZ STREQUAL "40000000")
  message(FATAL_ERROR "HW4-DISP-C3 CONSOLE_ONLY: ${LOCO_CYD_PROFILE} must use SPI20")
endif()
set(CYD_LCD_SPI_HZ "${CYD_LCD_SPI_HZ}" CACHE STRING
    "LCD SPI clock requested (CONSOLE default 40MHz; HW3/BASIC_PROBE only 20MHz)")
set_property(CACHE CYD_LCD_SPI_HZ PROPERTY STRINGS 20000000 40000000)
message(STATUS "HW4-DISP-C3 BUILD_PROFILE=${LOCO_CYD_PROFILE} REQUESTED_SPI_HZ=${CYD_LCD_SPI_HZ} ELECTRICAL_SPI_HZ=UNMEASURED")
