10 A%=0:B%=0
20 PRINT #8,"E04:BEGIN"
30 EVERY 5,0 GOSUB 1000
40 EVERY 20,0 GOSUB 1100
50 FOR I%=1 TO 8500
60 NEXT I%
70 PRINT #8,"E04:MAIN_A=";A%
80 PRINT #8,"E04:MAIN_B=";B%
90 R%=REMAIN(0)
100 PRINT #8,"E04:CANCEL=";R%
110 END
1000 A%=A%+1
1010 IF A%<=4 THEN PRINT #8,"E04:FIRST=";A%
1020 RETURN
1100 B%=B%+1
1110 IF B%<=4 THEN PRINT #8,"E04:SECOND=";B%
1120 RETURN
