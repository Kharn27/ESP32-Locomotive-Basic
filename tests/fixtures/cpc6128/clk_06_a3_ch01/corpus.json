    {
      "id": "S01_CH1_RECUR_RETURN",
      "question": "Does EVERY 10,1 deliver two or more channel-1 handler GOSUB/RETURN events in this bounded main loop?",
      "run_delays": 12,
      "lines": [
        "10 C%=0",
        "20 PRINT #8,\"S01:BEGIN\"",
        "30 EVERY 10,1 GOSUB 1000",
        "40 FOR I%=1 TO 8000",
        "50 NEXT I%",
        "60 R%=REMAIN(1)",
        "70 PRINT #8,\"S01:MAIN=\";C%",
        "80 PRINT #8,\"S01:CANCEL=\";R%",
        "90 END",
        "1000 C%=C%+1",
        "1010 IF C%<=4 THEN PRINT #8,\"S01:HIT=\";C%",
        "1020 RETURN"
      ]
    },
    {
      "id": "S02_CH1_REMAIN_CANCEL",
