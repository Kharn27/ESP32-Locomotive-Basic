        "60 FOR I%=1 TO 8500",
        "70 NEXT I%",
        "80 PRINT #8,\"S02:MAIN=\";C%",
        "90 PRINT #8,\"S02:R2=\";REMAIN(1)",
        "100 END",
        "1000 C%=C%+1",
        "1010 PRINT #8,\"S02:HIT=\";C%",
        "1020 RETURN"
      ]
    },
    {
