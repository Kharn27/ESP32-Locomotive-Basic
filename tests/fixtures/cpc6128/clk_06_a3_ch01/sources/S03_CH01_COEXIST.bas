10 A%=0:B%=0
20 PRINT #8,"S03:BEGIN"
30 EVERY 10,0 GOSUB 1000
40 EVERY 12,1 GOSUB 1100
50 FOR I%=1 TO 8500
60 NEXT I%
70 R0%=REMAIN(0)
80 R1%=REMAIN(1)
90 PRINT #8,"S03:CH0=";A%
100 PRINT #8,"S03:CH1=";B%
110 PRINT #8,"S03:R0=";R0%
120 PRINT #8,"S03:R1=";R1%
130 END
1000 A%=A%+1
1010 IF A%<=4 THEN PRINT #8,"S03:H0=";A%
1020 RETURN
1100 B%=B%+1
1110 IF B%<=4 THEN PRINT #8,"S03:H1=";B%
1120 RETURN
