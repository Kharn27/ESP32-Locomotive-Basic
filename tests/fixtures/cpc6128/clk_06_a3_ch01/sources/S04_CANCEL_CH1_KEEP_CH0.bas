10 A%=0:B%=0
20 PRINT #8,"S04:BEGIN"
30 EVERY 10,0 GOSUB 1000
40 EVERY 2,1 GOSUB 1100
50 R1%=REMAIN(1)
60 PRINT #8,"S04:REMAIN1=";R1%
70 FOR I%=1 TO 8500
80 NEXT I%
90 R0%=REMAIN(0)
100 PRINT #8,"S04:CH0=";A%
110 PRINT #8,"S04:CH1=";B%
120 PRINT #8,"S04:REMAIN0=";R0%
130 PRINT #8,"S04:R1AGAIN=";REMAIN(1)
140 END
1000 A%=A%+1
1010 IF A%<=4 THEN PRINT #8,"S04:H0=";A%
1020 RETURN
1100 B%=B%+1
1110 IF B%<=4 THEN PRINT #8,"S04:H1=";B%
1120 RETURN
