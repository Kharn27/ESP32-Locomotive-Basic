10 A%=0:B%=0
20 PRINT #8,"S03:BEGIN"
30 EVERY 10,2 GOSUB 1000
40 EVERY 12,3 GOSUB 1100
50 FOR I%=1 TO 9000
60 NEXT I%
70 R2%=REMAIN(2)
80 R3%=REMAIN(3)
90 PRINT #8,"S03:CH2=";A%
100 PRINT #8,"S03:CH3=";B%
110 PRINT #8,"S03:R2=";R2%
120 PRINT #8,"S03:R3=";R3%
130 END
1000 A%=A%+1
1010 IF A%<=4 THEN PRINT #8,"S03:H2=";A%
1020 RETURN
1100 B%=B%+1
1110 IF B%<=4 THEN PRINT #8,"S03:H3=";B%
1120 RETURN
