10 A%=0:B%=0
20 PRINT #8,"S04:BEGIN"
30 EVERY 10,2 GOSUB 1000
40 EVERY 2,3 GOSUB 1100
50 R3%=REMAIN(3)
60 PRINT #8,"S04:REMAIN3=";R3%
70 FOR I%=1 TO 9000
80 NEXT I%
90 R2%=REMAIN(2)
100 PRINT #8,"S04:CH2=";A%
110 PRINT #8,"S04:CH3=";B%
120 PRINT #8,"S04:REMAIN2=";R2%
130 PRINT #8,"S04:R3AGAIN=";REMAIN(3)
140 END
1000 A%=A%+1
1010 IF A%<=4 THEN PRINT #8,"S04:H2=";A%
1020 RETURN
1100 B%=B%+1
1110 IF B%<=4 THEN PRINT #8,"S04:H3=";B%
1120 RETURN
