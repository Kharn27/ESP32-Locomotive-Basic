10 A%=0:B%=0:O%=0
20 PRINT #8,"S04:BEGIN"
30 DI
40 EVERY 10,2 GOSUB 1000
50 EVERY 12,3 GOSUB 1100
60 PRINT #8,"S04:PRE2=";A%
70 PRINT #8,"S04:PRE3=";B%
80 FOR I%=1 TO 5000
90 NEXT I%
100 PRINT #8,"S04:DI2=";A%
110 PRINT #8,"S04:DI3=";B%
120 EI
130 PRINT #8,"S04:EI2=";A%
140 PRINT #8,"S04:EI3=";B%
150 FOR I%=1 TO 6000
160 NEXT I%
170 PRINT #8,"S04:POST2=";A%
180 PRINT #8,"S04:POST3=";B%
190 R2%=REMAIN(2)
200 R3%=REMAIN(3)
210 PRINT #8,"S04:R2=";R2%
220 PRINT #8,"S04:R3=";R3%
230 END
1000 A%=A%+1:O%=O%+1
1010 IF O%<=8 THEN PRINT #8,"S04:ORDER=";O%;",2,";A%
1020 RETURN
1100 B%=B%+1:O%=O%+1
1110 IF O%<=8 THEN PRINT #8,"S04:ORDER=";O%;",3,";B%
1120 RETURN
